@model TpFinal_Lab2.Models.Cliente

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    
                    <h2 class="fw-bold text-dark mb-4 pb-2 border-bottom">👤 Detalles del Cliente</h2>

                    <div class="text-secondary fs-6 mb-4">
                        <p class="mb-3 d-flex align-items-center">
                            <i class="bi bi-card-heading text-dark me-3 fs-5"></i>
                            <strong class="text-dark me-2">DNI:</strong> @Model.Dni
                        </p>
                        <p class="mb-3 d-flex align-items-center">
                            <i class="bi bi-person-badge text-dark me-3 fs-5"></i>
                            <strong class="text-dark me-2">Nombre y Apellido:</strong> @Model.Nombre @Model.Apellido
                        </p>
                        <p class="mb-3 d-flex align-items-center">
                            <i class="bi bi-telephone text-dark me-3 fs-5"></i>
                            <strong class="text-dark me-2">Telefono:</strong> @(string.IsNullOrEmpty(Model.Telefono) ? "No posee telefono" : Model.Telefono)
                        </p>
                        <p class="mb-0 d-flex align-items-center">
                            <i class="bi bi-envelope text-dark me-3 fs-5"></i>
                            <strong class="text-dark me-2">Email:</strong> @Model.Email
                        </p>
                    </div>

                    <div class="d-flex justify-content-start pt-3 border-top">
                        <a asp-action="Listar" class="btn btn-outline-dark px-4 rounded-pill">
                            <i class="bi bi-arrow-left me-2"></i> Volver a Clientes
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>