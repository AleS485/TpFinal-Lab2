@model List<TpFinal_Lab2.Models.Desarrolladora>
@{
    ViewData["Title"] = "Ver Desarrolladoras";
}

<div id="app" class="container mt-4">

    <div v-if="mensajeExito" class="alert alert-success alert-dismissible fade show" role="alert">
        {{ mensajeExito }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>


    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-light fw-bold">Desarrolladoras: </h2>
        <a class="btn btn-light fw-semibold shadow-sm" @@click="mostrarRegistrar">➕ Cargar Desarrolladora </a>
    </div>  

    <div class="card shadow border-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead>
                    <tr class="table-dark">
                        <th class="ps-3 py-3">ID</th>
                        <th class="py-3">Nombre</th>
                        <th class="py-3">Pagina Web</th>
                        <th class="text-end pe-3 py-3">Opciones ⚙️</th>
                    </tr>
                </thead>
                <tbody class="bg-white">
                    <tr v-for="desarrolladora in desarrolladoras" :key="desarrolladora.id">
                        <td class="ps-3">
                            <span class="badge bg-dark font-monospace">{{ desarrolladora.id }}</span>
                        </td>
                        <td class="fw-semibold text-dark">{{ desarrolladora.nombre }}</td>
                        <td class="fw-semibold text-dark">{{ desarrolladora.web }}</td>
                        <td class="text-end pe-3">
                            <button class="btn btn-sm btn-outline-dark rounded-pill px-3 me-1" @@click="mostrarEditar(desarrolladora)">✏️ Editar</button>  
                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3" @@click="mostrarEliminacion(desarrolladora.id)">❌ Eliminar</button>
                        </td>
                    </tr>
                    <tr v-if="desarrolladoras.length == 0">
                        <td colspan="7" class="text-center text-muted py-4">No hay desarrolladoras cargadas</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="modal fade" id="modalEliminar" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content text-dark">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">CONFIRMAR ACCION</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center">
                    <p>Queres borrar esta desarrolladora?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-danger" @@click="eliminarDesarrolladora">Eliminar</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalRegistrar" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content text-dark">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">REGISTRAR DESARROLLADORA</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">

                    <div v-if="mensajeError" class="alert alert-danger" role="alert">
                        {{ mensajeError }}
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre:</label>
                        <input type="text" class="form-control" v-model="nuevaDesarrolladora.nombre">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Web:</label>
                        <input type="text" class="form-control" v-model="nuevaDesarrolladora.web">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" @@click="registrarDesarrolladora">Registrar</button>
                </div>
            </div>
        </div>
    </div>

    
    <div class="modal fade" id="modalEditar" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content text-dark">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">EDITAR DESARROLLADORA</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">

                    <div v-if="mensajeErrorEditar" class="alert alert-danger" role="alert">
                        {{ mensajeErrorEditar }}
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre:</label>
                        <input type="text" class="form-control" v-model="desarrolladoraEditada.nombre">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Web:</label>
                        <input type="text" class="form-control" v-model="desarrolladoraEditada.web">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" @@click="actualizarDesarrolladora">Guardar Cambios</button>
                </div>
            </div>
        </div>
    </div>



    <div class="d-flex justify-content-center mt-3">
        <nav>
            <ul class="pagination">
                <li class="page-item">
                    <button class="page-link" @@click="cambiarPagina(paginaActual - 1)" :disabled="paginaActual == 1">Pag Anterior</button>
                </li>

                <li class="page-item active">
                    <span class="page-link">{{ paginaActual }}</span>
                </li>

                <li class="page-item">
                    <button class="page-link" @@click="cambiarPagina(paginaActual + 1)" :disabled="!haySiguiente">Pag Siguiente</button>
                </li>
            </ul>
        </nav>
    </div>


</div>



<script>
    Vue.createApp({
        data() {
            return {
                desarrolladoras: [],
                paginaActual: 1,
                haySiguiente: false,
                mensajeExito: '',
                mensajeError: '',
                idDesarrolladoraEliminar: null,
                nuevaDesarrolladora: {
                    nombre: '',
                    web: ''
                },
                desarrolladoraEditada: { 
                    id: null, 
                    nombre: '',
                    web: ''
                },
                mensajeErrorEditar: ''
            }
        },
        methods: {
            
            async cargarDesarrolladoras(pagina = 1){
                try{
                    const response = await fetch(`/Desarrolladora/TraerDesarrolladoras?pagina=${pagina}`);
                    const data = await response.json();
                    this.desarrolladoras = data.desarrolladoras;
                    this.paginaActual = data.paginaActual;
                    this.haySiguiente = data.haySiguiente;
                } catch(error){
                    console.error("ERROR CARGANDO DESARROLLADORAS", error);
                }
            },

            cambiarPagina(nuevaPagina){
                if(nuevaPagina < 1) return;
                this.cargarDesarrolladoras(nuevaPagina);
            },

            mostrarEliminacion(id){
                this.idDesarrolladoraEliminar = id;
                const myModal = new bootstrap.Modal('#modalEliminar');
                myModal.show();
            },

            async eliminarDesarrolladora(){
                try{
                    const response = await fetch(`/Desarrolladora/Eliminar/${this.idDesarrolladoraEliminar}`,{
                        method: 'POST'
                    })
                    const data = await response.json();

                    if(data.success){
                        const modalElement = document.getElementById('modalEliminar');
                        const modal = bootstrap.Modal.getInstance(modalElement);
                        modal.hide();
                        this.cargarDesarrolladoras(this.paginaActual);
                        this.mensajeExito = "DESARROLLADORA ELIMINADA CORRECTAMENTE";
                    } else{
                        alert("ERROR ELIMINANDO DESARROLLADORA: " + data.message);
                    }


                }catch(error){
                    console.error("ERROR ELIMINANDO DESARROLLADORA", error);
                }
            },

            mostrarRegistrar(){
                this.nuevaDesarrolladora = { nombre: '', web: '' };
                const myModal = new bootstrap.Modal('#modalRegistrar');
                myModal.show();
            },

            async registrarDesarrolladora(){
                this.mensajeError = '';
                try{
                    const response = await fetch('/Desarrolladora/Registrar', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(this.nuevaDesarrolladora)
                    });
                    
                    const data = await response.json();

                    if(data.success){
                        const modalElement = document.getElementById('modalRegistrar');
                        const modal = bootstrap.Modal.getInstance(modalElement);
                        modal.hide();
                        this.cargarDesarrolladoras(this.paginaActual);
                        this.mensajeExito = "DESARROLLADORA REGISTRADA CORRECTAMENTE";
                    } else {
                        this.mensajeError = data.message;
                    }
                } catch(error){
                    console.error("ERROR REGISTRANDO DESARROLLADORA", error);
                }
            }, 

            mostrarEditar(desarrolladora){
                this.mensajeErrorEditar = '';
                this.desarrolladoraEditada.id = desarrolladora.id;
                this.desarrolladoraEditada.nombre = desarrolladora.nombre;
                this.desarrolladoraEditada.web = desarrolladora.web;
                const myModal = new bootstrap.Modal('#modalEditar');
                myModal.show();
            },

            async actualizarDesarrolladora(){
                this.mensajeErrorEditar = '';
                try{
                    const response = await fetch(`/Desarrolladora/Editar`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(this.desarrolladoraEditada)
                    });

                    const data = await response.json();
                    if(data.success){
                        const modalElement = document.getElementById('modalEditar');
                        const modal = bootstrap.Modal.getInstance(modalElement);
                        modal.hide();
                        this.cargarDesarrolladoras(this.paginaActual);
                        this.mensajeExito = "DESARROLLADORA EDITADA CORRECTAMENTE";
                    } else{
                        this.mensajeErrorEditar = data.message;
                    }
                    



                } catch(error){
                    console.error("ERROR EDITANDO LA DESARROLLADORA", error);
                    this.mensajeErrorEditar = "ERROR DEL SERVER EDITANDO LA DESARROLLADORA";
                }
            }


        },
        mounted(){
            this.cargarDesarrolladoras();
        }
    }).mount('#app');
</script>






