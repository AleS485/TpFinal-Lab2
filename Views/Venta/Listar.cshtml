@model List<TpFinal_Lab2.Models.Venta>
@{
    ViewData["Title"] = "Ver Ventas";
    var Pagina = ViewBag.Pagina ?? 1;
    var HaySiguiente = ViewBag.HaySiguiente ?? false;
}

<div class="container mt-4">

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }


    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-light fw-bold">Ventas: </h2>
        <a asp-action="Registrar" class="btn btn-light fw-semibold shadow-sm">➕ Cargar Venta </a>
    </div>  

    <div class="card shadow border-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead>
                    <tr class="table-dark">
                        <th class="ps-3 py-3">ID</th>
                        <th class="py-3">Fecha y Hora</th>
                        <th class="py-3">Juego</th>
                        <th class="py-3">Cliente</th>
                        <th class="py-3">Cantidad</th>
                        <th class="py-3">Total</th>
                        <th class="text-end pe-3 py-3">Opciones ⚙️</th>
                    </tr>
                </thead>
                <tbody class="bg-white">
                    @foreach (var venta in Model)
                    {
                        <tr>
                            <td class="ps-3">
                                <span class="badge bg-dark font-monospace">@venta.Id</span>
                            </td>
                            <td class="fw-semibold text-dark">@venta.FechaHora.ToString("dd/MM/yyyy")</td>
                            <td>@(venta.Juego != null ? venta.Juego.Titulo : "Juego no disponible")</td>
                            <td>@(venta.Cliente != null ? venta.Cliente.Nombre : "Cliente no disponible")</td>
                            <td>
                                <span class="badge bg-secondary">
                                    @venta.Cantidad
                                </span>
                            </td>
                            <td class="text-success fw-bold">$@venta.PrecioTotal.ToString()</td>
                            <td class="text-end pe-3">
                                <a asp-action="Eliminar" asp-route-id="@venta.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3">❌ Eliminar</a>
                            </td>
                        </tr>
                    }
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No hay ventas registradas</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination justify-content-center">
            @if (Pagina > 1)
            {
                <li class="page-item">
                    <a class="page-link bg-dark text-light border-secondary" href="~/Venta/Listar?pagina=@(Pagina - 1)" aria-label="Anterior">
                        Anterior
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link bg-dark text-secondary border-secondary">Anterior</span>
                </li>
            }

            <li class="page-item active">
                <span class="page-link bg-primary border-primary">@Pagina</span>
            </li>

            @if (HaySiguiente)
            {
                <li class="page-item">
                    <a class="page-link bg-secondary border-secondary text-white fw-bold" href="~/Venta/Listar?pagina=@(Pagina + 1)" aria-label="Siguiente">
                        Siguiente
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link bg-dark text-secondary border-secondary">Siguiente</span>
                </li>
            }
        </ul>
    </nav>
</div>