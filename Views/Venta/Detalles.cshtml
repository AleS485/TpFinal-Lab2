@model TpFinal_Lab2.Models.Venta

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    
                    <h2 class="fw-bold text-dark mb-4 pb-2 border-bottom">🛒 Detalles de la Venta</h2>

                    <div class="text-secondary fs-6 mb-4">
                        <p class="mb-3 d-flex align-items-center">
                            <i class="bi bi-hash text-dark me-3 fs-5"></i>
                            <strong class="text-dark me-2">ID de Venta:</strong> @Model.Id
                        </p>
                        <p class="mb-3 d-flex align-items-center">
                            <i class="bi bi-calendar-event text-dark me-3 fs-5"></i>
                            <strong class="text-dark me-2">Fecha y Hora:</strong> @Model.FechaHora.ToString("dd/MM/yyyy")
                        </p>
                        <p class="mb-3 d-flex align-items-center">
                            <i class="bi bi-cart-check text-dark me-3 fs-5"></i>
                            <strong class="text-dark me-2">Cantidad:</strong> @Model.Cantidad
                        </p>
                        <p class="mb-3 d-flex align-items-center">
                            <i class="bi bi-currency-dollar text-dark me-3 fs-5"></i>
                            <strong class="text-dark me-2">Precio Total:</strong> $@Model.PrecioTotal
                        </p>
                        <p class="mb-3 d-flex align-items-center">
                            <i class="bi bi-controller text-dark me-3 fs-5"></i>
                            <strong class="text-dark me-2">Juego:</strong> @(Model.Juego?.Titulo ?? "N/A")
                        </p>
                        <p class="mb-3 d-flex align-items-center">
                            <i class="bi bi-person text-dark me-3 fs-5"></i>
                            <strong class="text-dark me-2">Cliente:</strong> @(Model.Cliente != null ? $"{Model.Cliente.Nombre} {Model.Cliente.Apellido}" : "N/A")
                        </p>
                        <p class="mb-0 d-flex align-items-center">
                            <i class="bi bi-person-badge text-dark me-3 fs-5"></i>
                            <strong class="text-dark me-2">Venta realizada por:</strong> @(Model.Usuario != null ? $"{Model.Usuario.Nombre} {Model.Usuario.Apellido}" : "N/A")
                        </p>
                    </div>

                    <div class="d-flex justify-content-start pt-3 border-top">
                        <a asp-action="Listar" class="btn btn-outline-dark px-4 rounded-pill">
                            <i class="bi bi-arrow-left me-2"></i> Volver a Ventas
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>