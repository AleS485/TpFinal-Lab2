@model TpFinal_Lab2.Models.Noticia

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    
                    <h1 class="fw-bold text-dark mb-3">@Model.Titulo</h1>

                    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom text-muted small">
                        <span><i class="bi bi-calendar-event me-1"></i> Publicado el: <strong>@Model.Fecha.ToString("dd/MM/yyyy")</strong></span>
                        <span><i class="bi bi-person-circle me-1"></i> Creada por: <strong>@ViewBag.NombreUsuario</strong></span>
                    </div>

                    <div class="card-text text-secondary mb-5 text-break lh-base">
                        @Model.Contenido
                    </div>

                    <div class="d-flex justify-content-start">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="bi bi-arrow-left me-2"></i> Volver a Noticias
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>