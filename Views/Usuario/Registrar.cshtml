@model TpFinal_Lab2.Models.Usuario
@{
    ViewData["Title"] = "Registrar Empleado";
}

<div id="registroUsuario" class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-4 bg-white p-4 p-md-5">
                <h3 class="text-center mb-4 text-dark fw-bold">Registrar Empleado 👤</h3>

                <form asp-action="Registrar" method="post" enctype="multipart/form-data">
                    
                    <div class="mb-3">
                        <label class="form-label text-dark fw-semibold">Nombre: </label>
                        <input type="text" name="Nombre" v-model="nombre" class="form-control rounded-3" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-dark fw-semibold">Apellido: </label>
                        <input type="text" name="Apellido" v-model="apellido" class="form-control rounded-3" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-dark fw-semibold">Email: </label>
                        <input type="email" name="Email" v-model="email" class="form-control rounded-3" required />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-dark fw-semibold">Contraseña: </label>
                        <input type="password" name="Password" class="form-control rounded-3" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-dark fw-semibold">Rol: </label>
                        <select name="Role" class="form-select rounded-3" required>
                            <option value="Empleado">Empleado</option>
                            <option value="Administrador">Administrador</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-dark fw-semibold">Avatar / Foto: </label>
                        <input type="file" name="avatarFile" v-on:change="previsualizar" class="form-control rounded-3" accept="image/*" />

                        <div class="text-center mt-3" v-if="preview">
                            <img v-bind:src="preview" width="120" height="120" class="rounded-circle border object-fit-cover shadow-sm" />
                        </div>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="Estado" class="form-check-input border" type="checkbox">
                        <label asp-for="Estado" class="form-check-label text-dark fw-bold">Disponible?</label>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-dark rounded-pill py-2">Registrar 📝</button>
                        <a asp-action="Listar" class="btn btn-outline-dark rounded-pill py-2 text-center">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        Vue.createApp({
            data() {
                return {
                    preview: null,
                    nombre: '',
                    apellido: '',
                    email: ''
                };
            },
            methods: {
                previsualizar(event) {
                    const file = event.target.files[0];
                    if (!file) {
                        this.preview = null;
                        return;
                    }

                    const reader = new FileReader();
                    reader.onload = (e) => {
                        this.preview = e.target.result;
                    };
                    reader.readAsDataURL(file);
                }
            }
        }).mount('#registroUsuario');
    </script>
}