@model IEnumerable<TpFinal_Lab2.Models.Noticia>
@{
    var paginaActual = ViewBag.Pagina ?? 1;
    var haySiguiente = ViewBag.HaySiguiente ?? false;
}


<div class="container my-4">
    <h2 class="mb-4 text-center">NOTICIAS</h2>

    <div class="row">
        @foreach (var noticia in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm border-0 rounded-3">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold text-dark">@noticia.Titulo</h5>
                        <h6 class="card-subtitle mb-2 text-muted small">@noticia.Fecha.ToString("dd/MM/yyyy")</h6>
                        

                        <p class="card-text text-secondary flex-grow-1 text-truncate">
                            @noticia.Contenido
                        </p>

                        <div class="text-end mt-3">
                            <a asp-action="Detalles" asp-route-id="@noticia.IdNoticia" class="btn btn-outline-primary btn-sm px-4">Ver</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <nav aria-label="Page navigation" class="mt-4">
    <ul class="pagination justify-content-center">
        @if (paginaActual > 1)
        {
            <li class="page-item">
                <a class="page-link bg-dark text-light border-secondary" asp-action="Index" asp-route-pagina="@(paginaActual - 1)" aria-label="Anterior">
                    Anterior
                </a>
            </li>
        }
        else
        {
            <li class="page-item disabled">
                <span class="page-link bg-dark text-secondary border-secondary">Anterior</span>
            </li>
        }

        <li class="page-item active">
            <span class="page-link bg-primary border-primary">@paginaActual</span>
        </li>

        
        @if (haySiguiente)
        {
            <li class="page-item">
                <a class="page-link bg-secondary border-secondary text-white fw-bold" asp-action="Index" asp-route-pagina="@(paginaActual + 1)" aria-label="Siguiente">
                    Siguiente
                </a>
            </li>
        }
        else
        {
            <li class="page-item disabled">
                <span class="page-link bg-dark text-secondary border-secondary">Siguiente</span>
            </li>
        }
    </ul>
</nav>

</div>