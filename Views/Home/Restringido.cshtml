@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow-sm border-0 rounded-4 bg-white p-5">
                <div class="mb-3 text-danger">
                    <i class="bi bi-shield-lock-fill display-4"></i>
                </div>
                <h2 class="h4 text-dark fw-bold mb-3">Acceso Restringido</h2>
                <p class="text-muted mb-4">No tenes permisos para ver este contenido</p>
                <div>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark px-4 rounded-pill">Volver al Inicio</a>
                </div>
            </div>
        </div>
    </div>
</div>