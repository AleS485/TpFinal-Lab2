@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 rounded-4 bg-white p-4 p-md-5">
                <h3 class="text-center mb-4 text-dark fw-bold">Iniciar Sesion 🔐</h3>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger py-2 text-center rounded-3" role="alert">
                        @ViewBag.Error
                    </div>
                }

                <form asp-action="Login" method="post">
                    <div class="mb-3">
                        <label class="form-label text-dark fw-semibold">Email: </label>
                        <input type="email" name="email" class="form-control rounded-3" placeholder="usuario@correo.com" required>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-dark fw-semibold">Contrasena: </label>
                        <input type="password" name="password" class="form-control rounded-3" placeholder="••••••••" required>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-dark rounded-pill py-2">Ingresar 🚀</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>