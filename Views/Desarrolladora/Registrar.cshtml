@model TpFinal_Lab2.Models.Desarrolladora
@{
    ViewData["Title"] = "Registrar Desarrolladora";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card bg-dark border-secondary shadow-lg">
            <div class="card-body p-4 text-light">
                <h3 class="text-center mb-4 fw-bold">🎮 Registrar Desarrolladora</h3>

                <form asp-action="Registrar" method="post">
                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label text-secondary">Nombre del Estudio:</label>
                        <input asp-for="Nombre" class="form-control bg-black text-light border-secondary" required>
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Web" class="form-label text-secondary">Pagina Web:</label>
                        <input asp-for="Web" class="form-control bg-black text-light border-secondary">
                        <span asp-validation-for="Web" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <a asp-action="Listar" class="btn btn-outline-secondary btn-sm px-3">Volver</a>
                        <button type="submit" class="btn btn-light fw-semibold px-4">Guardar 📝</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>